# Demo booking (see "Demo booking" in the README). Until all of the required keys are set, the
# Request a Demo form opens a pre-filled email draft instead of offering times.

# Google service account with domain-wide delegation
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# The Workspace user whose calendar holds the demos. Busy times on it block slots.
GOOGLE_CALENDAR_USER=

# Resend. The sender's domain must be verified in Resend.
RESEND_API_KEY=
DEMO_EMAIL_FROM="Hawyia <demos@hawyiapremium.com>"

# Optional: comma-separated team addresses. Defaults to the company email in lib/site.ts.
DEMO_TEAM_EMAILS=

# Outgoing email through Microsoft 365 (lib/mail.ts): contact forms and demo confirmations.
# Signs in with an Entra ID app (client credentials, OAuth2) that has the SMTP.SendAsApp permission;
# Exchange must also allow that app to send as SMTP_USER (see "Email" in the README).
# When these are set, Microsoft 365 is used instead of Resend.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: the From line. Defaults to "Hawyia Premium <SMTP_USER>".
MAIL_FROM=
MS_OBJECT_ID=

# Optional Gmail TEST MODE, for testing before the Microsoft 365 Exchange step is done.
# Only active when EMAIL_TEST_MODE=gmail; the dashboard shows a "Test mode" banner. Never set it on Vercel.
# GMAIL_APP_PASSWORD is a 16-character App password (Google Account → Security → 2-Step Verification → App passwords).
EMAIL_TEST_MODE=
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: send team notifications here instead of info@ while testing (comma-separated).
GMAIL_TEST_TO=

# Email admin dashboard (/admin): see "Email admin dashboard" in the README.
# MongoDB Atlas connection string; stores email settings (secret encrypted), templates and logs.
MONGODB_URI=
MONGODB_DB=hawyia
# 32 random bytes, base64 or hex. Encrypts the client secret in the database. Never change it once set.
EMAIL_SECRET_KEY=
# 32+ random characters. Signs admin session cookies.
ADMIN_SESSION_SECRET=
# Microsoft 365 accounts allowed to sign in to /admin, comma-separated.
ADMIN_EMAILS=
# Optional: a separate Entra app for admin sign-in (defaults to the MS_* app above).
ADMIN_AUTH_TENANT_ID=
ADMIN_AUTH_CLIENT_ID=
ADMIN_AUTH_CLIENT_SECRET=
# Vercel Cron sends this to /api/cron/email-retry/ (failed emails are retried).
CRON_SECRET=
